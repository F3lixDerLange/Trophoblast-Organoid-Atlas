// custom config for RAM and CPU profiling of integration steps (ps-based)

process {

    // ========== scVI ==========
    withName: 'SCVITOOLS_SCVI' {

        beforeScript = """
            echo "timestamp cpu_percent_total mem_percent_total rss_kb_total vsz_kb_total" > scvi_usage.log

            monitor() {
              # Session ID of this job
              sid=\$(ps -o sid= -p \$\$ | tr -d " ")

              while true; do
                ts=\$(date +%s)

                # Sum CPU, MEM, RSS, VSZ over *all* processes in this session
                stats=\$(
                  ps --no-headers -o %cpu,%mem,rss,vsz -s "\$sid" 2>/dev/null \\
                  | awk '{cpu+=\$1; mem+=\$2; rss+=\$3; vsz+=\$4} END{if (NR>0) printf "%.1f %.1f %d %d", cpu, mem, rss, vsz}'
                )

                if [ -n "\$stats" ]; then
                  echo "\$ts  \$stats" >> scvi_usage.log
                fi

                sleep 1
              done
            }

            monitor &
        """
    }

    // ========== Harmony ==========
    withName: 'SCANPY_HARMONY' {

        beforeScript = """
            echo "timestamp cpu_percent_total mem_percent_total rss_kb_total vsz_kb_total" > harmony_usage.log

            monitor() {
              sid=\$(ps -o sid= -p \$\$ | tr -d " ")

              while true; do
                ts=\$(date +%s)

                stats=\$(
                  ps --no-headers -o %cpu,%mem,rss,vsz -s "\$sid" 2>/dev/null \\
                  | awk '{cpu+=\$1; mem+=\$2; rss+=\$3; vsz+=\$4} END{if (NR>0) printf "%.1f %.1f %d %d", cpu, mem, rss, vsz}'
                )

                if [ -n "\$stats" ]; then
                  echo "\$ts  \$stats" >> harmony_usage.log
                fi

                sleep 1
              done
            }

            monitor &
        """
    }

    // ========== BBKNN ==========
    withName: 'INTEGRATION_BBKNN' {

        beforeScript = """
            echo "timestamp cpu_percent_total mem_percent_total rss_kb_total vsz_kb_total" > bbknn_usage.log

            monitor() {
              sid=\$(ps -o sid= -p \$\$ | tr -d " ")

              while true; do
                ts=\$(date +%s)

                stats=\$(
                  ps --no-headers -o %cpu,%mem,rss,vsz -s "\$sid" 2>/dev/null \\
                  | awk '{cpu+=\$1; mem+=\$2; rss+=\$3; vsz+=\$4} END{if (NR>0) printf "%.1f %.1f %d %d", cpu, mem, rss, vsz}'
                )

                if [ -n "\$stats" ]; then
                  echo "\$ts  \$stats" >> bbknn_usage.log
                fi

                sleep 1
              done
            }

            monitor &
        """
    }

    // ========== Combat ==========
    withName: 'SCANPY_COMBAT' {

        beforeScript = """
            echo "timestamp cpu_percent_total mem_percent_total rss_kb_total vsz_kb_total" > combat_usage.log

            monitor() {
              sid=\$(ps -o sid= -p \$\$ | tr -d " ")

              while true; do
                ts=\$(date +%s)

                stats=\$(
                  ps --no-headers -o %cpu,%mem,rss,vsz -s "\$sid" 2>/dev/null \\
                  | awk '{cpu+=\$1; mem+=\$2; rss+=\$3; vsz+=\$4} END{if (NR>0) printf "%.1f %.1f %d %d", cpu, mem, rss, vsz}'
                )

                if [ -n "\$stats" ]; then
                  echo "\$ts  \$stats" >> combat_usage.log
                fi

                sleep 1
              done
            }

            monitor &
        """
    }

    // ========== publishDir routing for all usage logs ==========
    withName: /SCVITOOLS_SCVI|SCANPY_HARMONY|INTEGRATION_BBKNN|SCANPY_COMBAT/ {

        publishDir(
            path: "${params.outdir}/pipeline_info/resource_usage",
            mode: 'copy',
            overwrite: true,
            saveAs: { fn ->
                if (fn.endsWith('scvi_usage.log'))
                    return "scvi/${fn}"
                if (fn.endsWith('harmony_usage.log'))
                    return "harmony/${fn}"
                if (fn.endsWith('bbknn_usage.log'))
                    return "bbknn/${fn}"
                if (fn.endsWith('combat_usage.log'))
                    return "combat/${fn}"

                return null   // ignore other files
            }
        )
    }
}
