// custom config for RAM and CPU profiling of integration steps (ps-based)

process {

    // ========== scVI ==========
    withName: 'SCVITOOLS_SCVI' {

        beforeScript = """
            LOG_DIR="${params.outdir}/resource_usage/scvi"
            mkdir -p "\$LOG_DIR"
            LOG_FILE="\$LOG_DIR/scvi_usage.log"

            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > scvi_usage.log
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > "\$LOG_FILE"

            monitor() {
              # Session ID of this job
              sid=\$(ps -o sid= -p \$\$ | tr -d " ")

              while true; do
                ts=\$(date +%s)

                # All processes in this session, pick the one with max RSS
                line=\$(
                  ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz -s "\$sid" 2>/dev/null \\
                  | sort -k5 -nr \\
                  | head -n 1
                )

                if [ -n "\$line" ]; then
                  echo "\$ts  \$line" | tee -a scvi_usage.log "\$LOG_FILE" > /dev/null
                fi

                sleep 1
              done
            }

            monitor &
        """
    }

    // ========== Harmony ==========
    withName: 'SCANPY_HARMONY' {

        beforeScript = """
            LOG_DIR="${params.outdir}/resource_usage/harmony"
            mkdir -p "\$LOG_DIR"
