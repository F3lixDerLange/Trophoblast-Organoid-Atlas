// custom config for RAM and CPU profiling of integration steps (ps-based)

process {

    // ========== scVI ==========
    withName: 'SCVITOOLS_SCVI' {

        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > scvi_usage.log

            monitor() {
              while true; do
                ts=$(date +%s)

                # Get the child process of this shell with the highest RSS
                line=$(ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz --ppid $$ --sort=-rss | head -n 1)

                # Only log if we actually found a child process
                if [ -n "$line" ]; then
                  echo "$ts  $line" >> scvi_usage.log
                fi

                sleep 1
              done
            }

            monitor &
            export MONITOR_PID=$!
            trap "kill $MONITOR_PID" EXIT
        '''


    }

    // ========== Harmony ==========
    withName: 'SCANPY_HARMONY' {
        cpus   = 4
        memory = '32 GB'
        time   = '24h'

        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > harmony_usage.log

            monitor() {
              while true; do
                ts=$(date +%s)
                line=$(ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz --ppid $$ --sort=-rss | head -n 1)
                if [ -n "$line" ]; then
                  echo "$ts  $line" >> harmony_usage.log
                fi
                sleep 1
              done
            }

            monitor &
            export MONITOR_PID=$!
            trap "kill $MONITOR_PID" EXIT
        '''

        publishDir = [
            path      : "monitoring/harmony",
            mode      : 'copy',
            pattern   : 'harmony_usage.log',
            overwrite : true
        ]
    }

    // ========== BBKNN ==========
    withName: 'INTEGRATION_BBKNN' {
        cpus   = 8
        memory = '64 GB'
        time   = '24h'

        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > bbknn_usage.log

            monitor() {
              while true; do
                ts=$(date +%s)
                line=$(ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz --ppid $$ --sort=-rss | head -n 1)
                if [ -n "$line" ]; then
                  echo "$ts  $line" >> bbknn_usage.log
                fi
                sleep 1
              done
            }

            monitor &
            export MONITOR_PID=$!
            trap "kill $MONITOR_PID" EXIT
        '''

        publishDir = [
            path      : "monitoring/bbknn",
            mode      : 'copy',
            pattern   : 'bbknn_usage.log',
            overwrite : true
        ]
    }

    // ========== Combat ==========
    withName: 'SCANPY_COMBAT' {
        cpus   = 2
        memory = '16 GB'
        time   = '8h'

        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > combat_usage.log

            monitor() {
              while true; do
                ts=$(date +%s)
                line=$(ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz --ppid $$ --sort=-rss | head -n 1)
                if [ -n "$line" ]; then
                  echo "$ts  $line" >> combat_usage.log
                fi
                sleep 1
              done
            }

            monitor &
            export MONITOR_PID=$!
            trap "kill $MONITOR_PID" EXIT
        '''

        publishDir = [
            path      : "monitoring/combat",
            mode      : 'copy',
            pattern   : 'combat_usage.log',
            overwrite : true
        ]
    }
}
