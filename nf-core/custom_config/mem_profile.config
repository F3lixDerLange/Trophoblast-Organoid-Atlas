// Ensure outdir is absolute so beforeScript writes outside work dir
params.outdir = file(params.outdir).absolutePath

// custom config for RAM and CPU profiling of integration steps (ps-based)

process {

    // ========== scVI ==========
    withName: 'SCVITOOLS_SCVI' {

        beforeScript = """
            LOG_DIR="${params.outdir}/pipeline_info/resource_usage/scvi"
            mkdir -p "\$LOG_DIR"
            LOG_FILE="\$LOG_DIR/scvi_usage.log"

            # echo "timestamp cpu_percent_total mem_percent_total rss_kb_total vsz_kb_total" > scvi_usage.log
            echo "timestamp cpu_percent_total mem_percent_total rss_kb_total vsz_kb_total" > "\$LOG_FILE"

            monitor() {
              # Session ID of this job
              sid=\$(ps -o sid= -p \$\$ | tr -d " ")

              while true; do
                ts=\$(date +%s)

                # Sum CPU, MEM, RSS, VSZ over *all* processes in this session
                stats=\$(
                  ps --no-headers -o %cpu,%mem,rss,vsz -s "\$sid" 2>/dev/null \\
                  | awk '{cpu+=\$1; mem+=\$2; rss+=\$3; vsz+=\$4} END{if (NR>0) printf "%.1f %.1f %d %d", cpu, mem, rss, vsz}'
                )

                if [ -n "\$stats" ]; then
                  echo "\$ts  \$stats" | tee -a scvi_usage.log "\$LOG_FILE" > /dev/null
                fi

                sleep 1
              done
            }

            monitor &
        """
    }

    // ========== Harmony ==========
    withName: 'SCANPY_HARMONY' {

        beforeScript = """
            LOG_DIR="${params.outdir}/pipeline_info/resource_usage/harmony"
            mkdir -p "\$LOG_DIR"
            LOG_FILE="\$LOG_DIR/harmony_usage.log"

            # echo "timestamp cpu_percent_total mem_percent_total rss_kb_total vsz_kb_total" > harmony_usage.log
            echo "timestamp cpu_percent_total mem_percent_total rss_kb_total vsz_kb_total" > "\$LOG_FILE"

            monitor() {
              sid=\$(ps -o sid= -p \$\$ | tr -d " ")

              while true; do
                ts=\$(date +%s)

                stats=\$(
                  ps --no-headers -o %cpu,%mem,rss,vsz -s "\$sid" 2>/dev/null \\
                  | awk '{cpu+=\$1; mem+=\$2; rss+=\$3; vsz+=\$4} END{if (NR>0) printf "%.1f %.1f %d %d", cpu, mem, rss, vsz}'
                )

                if [ -n "\$stats" ]; then
                  echo "\$ts  \$stats" | tee -a harmony_usage.log "\$LOG_FILE" > /dev/null
                fi

                sleep 1
              done
            }

            monitor &
        """
    }

    // ========== BBKNN ==========
    withName: 'INTEGRATION_BBKNN' {

        beforeScript = """
            LOG_DIR="${params.outdir}/pipeline_info/resource_usage/bbknn"
            mkdir -p "\$LOG_DIR"
            LOG_FILE="\$LOG_DIR/bbknn_usage.log"

            # echo "timestamp cpu_percent_total mem_percent_total rss_kb_total vsz_kb_total" > bbknn_usage.log
            echo "timestamp cpu_percent_total mem_percent_total rss_kb_total vsz_kb_total" > "\$LOG_FILE"

            monitor() {
              sid=\$(ps -o sid= -p \$\$ | tr -d " ")

              while true; do
                ts=\$(date +%s)

                stats=\$(
                  ps --no-headers -o %cpu,%mem,rss,vsz -s "\$sid" 2>/dev/null \\
                  | awk '{cpu+=\$1; mem+=\$2; rss+=\$3; vsz+=\$4} END{if (NR>0) printf "%.1f %.1f %d %d", cpu, mem, rss, vsz}'
                )

                if [ -n "\$stats" ]; then
                  echo "\$ts  \$stats" | tee -a bbknn_usage.log "\$LOG_FILE" > /dev/null
                fi

                sleep 1
              done
            }

            monitor &
        """
    }

    // ========== Combat ==========
    withName: 'SCANPY_COMBAT' {

        beforeScript = """
            LOG_DIR="${params.outdir}/pipeline_info/resource_usage/combat"
            mkdir -p "\$LOG_DIR"
            LOG_FILE="\$LOG_DIR/combat_usage.log"

            # echo "timestamp cpu_percent_total mem_percent_total rss_kb_total vsz_kb_total" > combat_usage.log
            echo "timestamp cpu_percent_total mem_percent_total rss_kb_total vsz_kb_total" > "\$LOG_FILE"

            monitor() {
              sid=\$(ps -o sid= -p \$\$ | tr -d " ")

              while true; do
                ts=\$(date +%s)

                stats=\$(
                  ps --no-headers -o %cpu,%mem,rss,vsz -s "\$sid" 2>/dev/null \\
                  | awk '{cpu+=\$1; mem+=\$2; rss+=\$3; vsz+=\$4} END{if (NR>0) printf "%.1f %.1f %d %d", cpu, mem, rss, vsz}'
                )

                if [ -n "\$stats" ]; then
                  echo "\$ts  \$stats" | tee -a combat_usage.log "\$LOG_FILE" > /dev/null
                fi

                sleep 1
              done
            }

            monitor &
        """
    }
}
