// custom config for RAM and CPU profiling of integration steps (ps-based)

process {

    // ========== scVI ==========
    withName: 'SCVITOOLS_SCVI' {

        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > scvi_usage.log

            monitor() {
              # Session ID of this job
              sid=$(ps -o sid= -p $$ | tr -d " ")

              while true; do
                ts=$(date +%s)

                # All processes in this session, pick the one with max RSS
                line=$(
                  ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz -s "$sid" 2>/dev/null \
                  | sort -k5 -nr \
                  | head -n 1
                )

                if [ -n "$line" ]; then
                  echo "$ts  $line" >> scvi_usage.log
                fi

                sleep 1
              done
            }

            monitor &
        '''
    }

    // ========== Harmony ==========
    withName: 'SCANPY_HARMONY' {

        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > harmony_usage.log

            monitor() {
              sid=$(ps -o sid= -p $$ | tr -d " ")

              while true; do
                ts=$(date +%s)

                line=$(
                  ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz -s "$sid" 2>/dev/null \
                  | sort -k5 -nr \
                  | head -n 1
                )

                if [ -n "$line" ]; then
                  echo "$ts  $line" >> harmony_usage.log
                fi

                sleep 1
              done
            }

            monitor &
        '''
    }

    // ========== BBKNN ==========
    withName: 'INTEGRATION_BBKNN' {

        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > bbknn_usage.log

            monitor() {
              sid=$(ps -o sid= -p $$ | tr -d " ")

              while true; do
                ts=$(date +%s)

                line=$(
                  ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz -s "$sid" 2>/dev/null \
                  | sort -k5 -nr \
                  | head -n 1
                )

                if [ -n "$line" ]; then
                  echo "$ts  $line" >> bbknn_usage.log
                fi

                sleep 1
              done
            }

            monitor &
        '''
    }

    // ========== Combat ==========
    withName: 'SCANPY_COMBAT' {

        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > combat_usage.log

            monitor() {
              sid=$(ps -o sid= -p $$ | tr -d " ")

              while true; do
                ts=$(date +%s)

                line=$(
                  ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz -s "$sid" 2>/dev/null \
                  | sort -k5 -nr \
                  | head -n 1
                )

                if [ -n "$line" ]; then
                  echo "$ts  $line" >> combat_usage.log
                fi

                sleep 1
              done
            }

            monitor &
        '''
    }
}
