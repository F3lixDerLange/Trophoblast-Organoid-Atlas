// custom config for RAM and CPU profiling of integration steps (ps-based)

process {

    // ========== scVI ==========
    withName: 'SCVITOOLS_SCVI' {

        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > scvi_usage.log

            monitor() {
              while true; do
                ts=$(date +%s)

                # Consider this shell (PID=$$) and its children, pick the one with highest RSS
                line=$(
                  {
                    ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz -p $$     2>/dev/null
                    ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz --ppid $$ 2>/dev/null
                  } | sort -k5 -nr | head -n 1
                )

                if [ -n "$line" ]; then
                  echo "$ts  $line" >> scvi_usage.log
                fi

                sleep 1
              done
            }

            monitor &
            MONITOR_PID=$!

            cleanup() {
              kill "$MONITOR_PID" 2>/dev/null || true
            }

            trap cleanup EXIT
        '''
    }

    // ========== Harmony ==========
    withName: 'SCANPY_HARMONY' {

        beforeScript = '''
