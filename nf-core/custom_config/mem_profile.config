// custom config for RAM and CPU profiling of integration steps (Slurm + sstat)

process {

    // ========== scVI ==========
    withName: 'SCVITOOLS_SCVI' {
        // optional: tune resources for scVI
        cpus   = 8
        memory = '64 GB'
        time   = '24h'

        beforeScript = '''
            # Use Slurm job ID for sstat
            JOBID="${SLURM_JOB_ID:-$SLURM_JOBID}"

            # Header: timestamp, jobid, AveRSS, MaxRSS, AveCPU
            echo "timestamp jobid averss maxrss avecpu" > scvi_usage.log

            monitor() {
              while true; do
                ts=$(date +%s)

                # sstat: job-level stats (RAM/CPU for whole job)
                # AveRSS/MaxRSS are like 2000M, 45G etc.
                sstat -j "$JOBID" --noheader --format=JobID,AveRSS,MaxRSS,AveCPU \
                  | awk -v ts="$ts" 'NR==1 {print ts, $1, $2, $3, $4}' >> scvi_usage.log

                sleep 1
              done
            }

            monitor &
            export MONITOR_PID=$!
            trap "kill $MONITOR_PID" EXIT
        '''

        publishDir = [
            path      : "monitoring/scvi",
            mode      : 'copy',
            pattern   : 'scvi_usage.log',
            overwrite : true
        ]
    }

    // ========== Harmony ==========
    withName: 'SCANPY_HARMONY' {
        cpus   = 8
        memory = '32 GB'
        time   = '24h'

        beforeScript = '''
            JOBID="${SLURM_JOB_ID:-$SLURM_JOBID}"
            echo "timestamp jobid averss maxrss avecpu" > harmony_usage.log

            monitor() {
              while true; do
                ts=$(date +%s)
                sstat -j "$JOBID" --noheader --format=JobID,AveRSS,MaxRSS,AveCPU \
                  | awk -v ts="$ts" 'NR==1 {print ts, $1, $2, $3, $4}' >> harmony_usage.log
                sleep 1
              done
            }

            monitor &
            export MONITOR_PID=$!
            trap "kill $MONITOR_PID" EXIT
        '''

        publishDir = [
            path      : "monitoring/harmony",
            mode      : 'copy',
            pattern   : 'harmony_usage.log',
            overwrite : true
        ]
    }

    // ========== BBKNN ==========
    withName: 'INTEGRATION_BBKNN' {
        cpus   = 8
        memory = '64 GB'
        time   = '24h'

        beforeScript = '''
            JOBID="${SLURM_JOB_ID:-$SLURM_JOBID}"
            echo "timestamp jobid averss maxrss avecpu" > bbknn_usage.log

            monitor() {
              while true; do
                ts=$(date +%s)
                sstat -j "$JOBID" --noheader --format=JobID,AveRSS,MaxRSS,AveCPU \
                  | awk -v ts="$ts" 'NR==1 {print ts, $1, $2, $3, $4}' >> bbknn_usage.log
                sleep 1
              done
            }

            monitor &
            export MONITOR_PID=$!
            trap "kill $MONITOR_PID" EXIT
        '''

        publishDir = [
            path      : "monitoring/bbknn",
            mode      : 'copy',
            pattern   : 'bbknn_usage.log',
            overwrite : true
        ]
    }

    // ========== Combat ==========
    withName: 'SCANPY_COMBAT' {
        cpus   = 8
        memory = '32 GB'
        time   = '8h'

        beforeScript = '''
            JOBID="${SLURM_JOB_ID:-$SLURM_JOBID}"
            echo "timestamp jobid averss maxrss avecpu" > combat_usage.log

            monitor() {
              while true; do
                ts=$(date +%s)
                sstat -j "$JOBID" --noheader --format=JobID,AveRSS,MaxRSS,AveCPU \
                  | awk -v ts="$ts" 'NR==1 {print ts, $1, $2, $3, $4}' >> combat_usage.log
                sleep 1
              done
            }

            monitor &
            export MONITOR_PID=$!
            trap "kill $MONITOR_PID" EXIT
        '''

        publishDir = [
            path      : "monitoring/combat",
            mode      : 'copy',
            pattern   : 'combat_usage.log',
            overwrite : true
        ]
    }
}
