// custom config for RAM and CPU profiling

// helper: base outdir for monitoring logs
def MON_OUTDIR = params.outdir ?: 'results'

process {

    // ========== scVI ==========
    withName: 'SCVITOOLS_SCVI' {
        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > scvi_usage.log
            monitor() {
              while true; do
                ts=$(date +%s)
                ps -p $$ -o pid,ppid,%cpu,%mem,rss,vsz --no-headers \
                  | awk -v ts="$ts" '{print ts, $0}' >> scvi_usage.log
                sleep 1
              done
            }

            monitor &
            export MONITOR_PID=$!
            trap "kill $MONITOR_PID" EXIT
        '''

        publishDir = [
            path      : "${MON_OUTDIR}/monitoring/scvi",
            mode      : 'copy',
            pattern   : 'scvi_usage.log',
            overwrite : true
        ]
    }

    // ========== Harmony ==========
    withName: 'SCANPY_HARMONY' {
        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > harmony_usage.log
            monitor() {
              while true; do
                ts=$(date +%s)
                ps -p $$ -o pid,ppid,%cpu,%mem,rss,vsz --no-headers \
                  | awk -v ts="$ts" '{print ts, $0}' >> harmony_usage.log
                sleep 1
              done
            }

            monitor &
            export MONITOR_PID=$!
            trap "kill $MONITOR_PID" EXIT
        '''

        publishDir = [
            path      : "${MON_OUTDIR}/monitoring/harmony",
            mode      : 'copy',
            pattern   : 'harmony_usage.log',
            overwrite : true
        ]
    }

    // ========== BBKNN ==========
    withName: 'INTEGRATION_BBKNN' {
        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > bbknn_usage.log
            monitor() {
              while true; do
                ts=$(date +%s)
                ps -p $$ -o pid,ppid,%cpu,%mem,rss,vsz --no-headers \
                  | awk -v ts="$ts" '{print ts, $0}' >> bbknn_usage.log
                sleep 1
              done
            }

            monitor &
            export MONITOR_PID=$!
            trap "kill $MONITOR_PID" EXIT
        '''

        publishDir = [
            path      : "${MON_OUTDIR}/monitoring/bbknn",
            mode      : 'copy',
            pattern   : 'bbknn_usage.log',
            overwrite : true
        ]
    }

    // ========== Combat ==========
    withName: 'SCANPY_COMBAT' {
        beforeScript = '''
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > combat_usage.log
            monitor() {
              while true; do
                ts=$(date +%s)
                ps -p $$ -o pid,ppid,%cpu,%mem,rss,vsz --no-headers \
                  | awk -v ts="$ts" '{print ts, $0}' >> combat_usage.log
                sleep 1
              done
            }

            monitor &
            export MONITOR_PID=$!
            trap "kill $MONITOR_PID" EXIT
        '''

        publishDir = [
            path      : "${MON_OUTDIR}/monitoring/combat",
            mode      : 'copy',
            pattern   : 'combat_usage.log',
            overwrite : true
        ]
    }
}
