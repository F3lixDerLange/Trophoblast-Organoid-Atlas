            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > harmony_usage.log
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > "\$LOG_FILE"

            monitor() {
              sid=\$(ps -o sid= -p \$\$ | tr -d " ")

              while true; do
                ts=\$(date +%s)

                line=\$(
                  ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz -s "\$sid" 2>/dev/null \\
                  | sort -k5 -nr \\
                  | head -n 1
                )

                if [ -n "\$line" ]; then
                  echo "\$ts  \$line" | tee -a harmony_usage.log "\$LOG_FILE" > /dev/null
                fi

                sleep 1
              done
            }

            monitor &
        """
    }

    // ========== BBKNN ==========
    withName: 'INTEGRATION_BBKNN' {

        beforeScript = """
            LOG_DIR="${params.outdir}/resource_usage/bbknn"
            mkdir -p "\$LOG_DIR"
            LOG_FILE="\$LOG_DIR/bbknn_usage.log"

            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > bbknn_usage.log
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > "\$LOG_FILE"

            monitor() {
              sid=\$(ps -o sid= -p \$\$ | tr -d " ")

              while true; do
                ts=\$(date +%s)

                line=\$(
                  ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz -s "\$sid" 2>/dev/null \\
                  | sort -k5 -nr \\
                  | head -n 1
                )

                if [ -n "\$line" ]; then
                  echo "\$ts  \$line" | tee -a bbknn_usage.log "\$LOG_FILE" > /dev/null
                fi

                sleep 1
              done
            }

            monitor &
        """
    }

    // ========== Combat ==========
    withName: 'SCANPY_COMBAT' {

        beforeScript = """
            LOG_DIR="${params.outdir}/resource_usage/combat"
            mkdir -p "\$LOG_DIR"
            LOG_FILE="\$LOG_DIR/combat_usage.log"

            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > combat_usage.log
            echo "timestamp pid ppid cpu_percent mem_percent rss_kb vsz_kb" > "\$LOG_FILE"

            monitor() {
              sid=\$(ps -o sid= -p \$\$ | tr -d " ")

              while true; do
                ts=\$(date +%s)

                line=\$(
                  ps --no-headers -o pid,ppid,%cpu,%mem,rss,vsz -s "\$sid" 2>/dev/null \\
                  | sort -k5 -nr \\
                  | head -n 1
                )

                if [ -n "\$line" ]; then
                  echo "\$ts  \$line" | tee -a combat_usage.log "\$LOG_FILE" > /dev/null
                fi

                sleep 1
              done
            }

            monitor &
        """
    }
}
