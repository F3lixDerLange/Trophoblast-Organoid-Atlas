// CORRECT STRUCTURE: Define settings using a selector outside the main 'process' block

process {
    // This process block is for global defaults (e.g., cpus = 2)
    // Keep it empty or use it for settings that apply to ALL processes.
}

// Targeting the first process
withName: 'SCVITOOLS_SCVI' {
    executor {
        jobResources = [
            memory: '1s',
            cpu: '1s'
        ]
    }
}

// Targeting the second process
withName: 'SCANPY_HARMONY' {
    executor {
        jobResources = [
            memory: '1s',
            cpu: '1s'
        ]
    }
}

// Continue this pattern for INTEGRATION_BBKNN and SCANPY_COMBAT